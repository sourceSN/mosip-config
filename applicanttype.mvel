import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.time.Period;
import java.time.ZoneId;
import java.time.temporal.ValueRange;
import java.util.List;
import java.util.regex.Pattern;

String DATE_PATTERN = "yyyy/MM/dd";
String DATE_REGEX = "^\\d{4}(\\/)(((0)[1-9])|((1)[0-2]))(\\/)([0-2][0-9]|(3)[0-1])$";
Pattern datePattern = Pattern.compile(DATE_REGEX);

String MALE = "MLE";
String FEMALE = "FLE";

// Age group codes
String CHILD = "INFANT";
String MINOR = "MINOR";
String ADULT = "ADULT";

// Nationality type codes
String SND = "SND";          // Single Nationality
String DUAL_MULTIPLE = "DM"; // Dual/Multiple Nationality
String FOREIGNER = "FR";     // Foreign National

// Marital status codes
String SINGLE = "SNG";
String DIVORCED_WIDOWED = "DWD";
String MARRIED = "MRD";

def getAgeCode(identity) {
    if(ageGroups == null || !identity.containsKey('dateOfBirth'))
        return null;

    String dob = identity.get('dateOfBirth');
    if(!datePattern.matcher(dob).matches())
        return null;

    LocalDate date = LocalDate.parse(dob, DateTimeFormatter.ofPattern(DATE_PATTERN));
    LocalDate currentDate = LocalDate.now(ZoneId.of("UTC"));

    if(date.isAfter(currentDate)) { return 'KER-MSD-151'; }

    int ageInYears = Period.between(date, currentDate).getYears();

    String ageGroup = null;
    for(String groupName : ageGroups.keySet()) {
        String[] range = ((String)ageGroups.get(groupName)).split('-');
        if(ValueRange.of(Long.valueOf(range[0]), Long.valueOf(range[1])).isValidIntValue(ageInYears)) {
            ageGroup = groupName;
        }
    }

    return ageGroup == null ? null : ageGroup;
}

def isUpdateFlow(identity) {
  Object val = identity.getOrDefault('_flow', null);
  return (val == 'Update') ? true : false;
}

def getBioExceptionFlag(identity) {
    if(!identity.containsKey('isBioException')) { return false; }
    Object val = identity.getOrDefault('isBioException', null);
    return (val == 'true') ? true : (( val == 'false' ) ? false : null);
}

def getResidenceStatus(identity) {
    if(identity.containsKey('residenceStatusCode')) {
        return identity.getOrDefault('residenceStatusCode', null);
    }

    if(identity.containsKey('residenceStatus')) {
        Object val = identity.getOrDefault('residenceStatus', null);
        return val == null ? null :
            (val instanceof String ? (String)val : (String) ((List)val).get(0).value);
    }

    return null;
}

def getGenderType(identity) {
    if(identity.containsKey('genderCode')) {
        return identity.getOrDefault('genderCode', null);
    }

    if(identity.containsKey('gender')) {
        Object val = identity.getOrDefault('gender', null);
        return val == null ? null :
            (val instanceof String ? (String)val : (String) ((List)val).get(0).value);
    }

    return null;
}

def getNationalityType(identity) {
    if(identity.containsKey('nationalityCode')) {
        return identity.getOrDefault('nationalityCode', null);
    }

    if(identity.containsKey('nationality')) {
        Object val = identity.getOrDefault('nationality', null);
        return val == null ? null :
            (val instanceof String ? (String)val : (String) ((List)val).get(0).value);
    }

    return null;
}

def getMaritalStatus(identity) {
    if(identity.containsKey('maritalStatusCode')) {
        return identity.getOrDefault('maritalStatusCode', null);
    }

    if(identity.containsKey('maritalStatus')) {
        Object val = identity.getOrDefault('maritalStatus', null);
        return val == null ? null :
            (val instanceof String ? (String)val : (String) ((List)val).get(0).value);
    }

    return null;
}

def getApplicantType() {
  String genderType = getGenderType(identity);
  String nationalityType = getNationalityType(identity);
  String maritalStatus = getMaritalStatus(identity);
  String ageCode = getAgeCode(identity); // reserved for future age-based conditions

  if(genderType == null || nationalityType == null || maritalStatus == null) {
      return isUpdateFlow(identity) ? "000" : "KER-MSD-147";
  }

  System.out.println(genderType + " - " + nationalityType + " - " + maritalStatus);

  // SND or Dual/Multiple nationals
  if ((nationalityType == SND || nationalityType == DUAL_MULTIPLE) && maritalStatus == SINGLE) {
    return "001";
  } else if ((nationalityType == SND || nationalityType == DUAL_MULTIPLE) && maritalStatus == DIVORCED_WIDOWED) {
    return "002";
  } else if ((nationalityType == SND || nationalityType == DUAL_MULTIPLE) && genderType == MALE && maritalStatus == MARRIED) {
    return "003";
  } else if ((nationalityType == SND || nationalityType == DUAL_MULTIPLE) && genderType == FEMALE && maritalStatus == MARRIED) {
    return "004";
  }
  // Foreign nationals
  else if (nationalityType == FOREIGNER && maritalStatus == SINGLE) {
    return "005";
  } else if (nationalityType == FOREIGNER && maritalStatus == MARRIED) {
    return "006";
  } else if (nationalityType == FOREIGNER && maritalStatus == DIVORCED_WIDOWED && genderType == MALE) {
    return "007";
  } else if (nationalityType == FOREIGNER && maritalStatus == DIVORCED_WIDOWED && genderType == FEMALE) {
    return "008";
  }

  return "000";
}
